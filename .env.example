# Copy to .env.local

# Airtable (server only)
AIRTABLE_TOKEN=pat_xxx
AIRTABLE_BASE_ID=app7MFq3Lx27RY56f
AIRTABLE_TABLE=Orders

# Render Shipping Service
RENDER_SHIP_URL=https://<my-render-service>
RENDER_BEARER=<shared-bearer-token>

# Optional shipping defaults
SHIP_FROM_NAME=Edible Images by Kristen
SHIP_FROM_ADDRESS1=123 Example St
SHIP_FROM_CITY=Rochester
SHIP_FROM_STATE=NY
SHIP_FROM_ZIP=14626

# Optional: Image idea generation (mock works without these)
VERTEX_PROJECT_ID=
VERTEX_LOCATION=us-central1
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service_account.json
OPENAI_API_KEY=

# Optional: EasyPost (if you later rate/buy labels)
EASYPOST_API_KEY=
